<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Drops the expired neighbourhood texts and geocoding results (yatmo.map.cache). -->
    <record id="ir_cron_purge_cache" model="ir.cron">
        <field name="name">Yatmo: purge the expired cache</field>
        <field name="model_id" ref="model_yatmo_map_cache"/>
        <field name="state">code</field>
        <field name="code">model._purge_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
